# PostgreSQL / Neon
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Required only for: npx prisma db seed
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-of-12-or-more-characters"

# Optional: external UMAG synchronization service
BOT_SYNC_URL=""
BOT_SYNC_SECRET=""

# Optional: Telegram complaint alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_IDS=""
